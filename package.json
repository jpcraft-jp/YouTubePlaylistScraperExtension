{
  "name": "youtube_playlist_to_json",
  "private": true,
  "version": "2.1.0",
  "type": "module",
  "scripts": {
    "dev:firefox": "vite --mode firefox",
    "dev:chrome": "vite --mode chrome",
    "build:firefox": "tsc && vite build --mode firefox",
    "build:chrome": "tsc && vite build --mode chrome",
    "release:firefox": "node scripts/build-release.mjs firefox",
    "release:chrome": "node scripts/build-release.mjs chrome",
    "release": "npm run release:firefox && npm run release:chrome"
  },
  "dependencies": {
    "lucide-react": "^1.28.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.0.26",
    "@types/react-dom": "^18.0.9",
    "@types/webextension-polyfill": "^0.10.0",
    "@vitejs/plugin-react": "^4.2.1",
    "crx": "^5.0.1",
    "typescript": "~5.6.3",
    "vite": "^5.0.0",
    "vite-plugin-web-extension": "^4.0.0",
    "web-ext": "^10.5.0",
    "webextension-polyfill": "^0.10.0"
  }
}
